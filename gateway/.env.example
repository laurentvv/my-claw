# ============================================================
# gateway/.env.example — Configuration de l'environnement Gateway
# my-claw — Assistant personnel self-hosted, privacy-first
# ============================================================
#
# Copiez ce fichier vers .env.local et configurez les valeurs
# Les tokens vides seront générés automatiquement par setup.ps1
#
# ============================================================

# Base de données SQLite locale
DATABASE_URL="file:./prisma/dev.db"

# Token pour l'authentification WebChat (min 32 caractères)
# Générez un token sécurisé avec: openssl rand -hex 32
WEBCHAT_TOKEN=""

# Secret pour la validation des webhooks CRON (min 32 caractères)
# Générez un secret sécurisé avec: openssl rand -hex 32
CRON_SECRET=""

# URL de l'API Agent Python
AGENT_URL="http://localhost:8000"

# ============================================================
# Configuration Nextcloud Talk Bot (OPTIONNEL)
# ============================================================

# URL de votre instance Nextcloud (ex: https://cd.next-cloud.ovh)
NC_TALK_BASE_URL=""

# Secret partagé avec le bot Nextcloud (HMAC-SHA256, min 40 caractères)
# Générez avec: openssl rand -hex 64
NC_TALK_BOT_SECRET=""

# ============================================================
# Configuration des captures d'écran (OPTIONNEL)
# ============================================================

# Répertoire pour stocker les captures d'écran
# Défaut: C:\tmp\myclawshots
SCREENSHOT_DIR="C:\tmp\myclawshots"

# ============================================================
# Upload WebDAV des screenshots vers Nextcloud (OPTIONNEL)
# ============================================================

# Compte Nextcloud dédié pour l'upload des screenshots via WebDAV
# Permet d'afficher les images directement dans Nextcloud Talk

# Nom d'utilisateur du compte bot dans Nextcloud
NC_BOT_USERNAME="my-claw-bot"

# Mot de passe d'application généré dans Nextcloud
# (Paramètres personnels → Sécurité → Mots de passe d'application)
# Ce n'est PAS le mot de passe du compte, mais un token d'application
NC_BOT_PASSWORD=""
